# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pmgis_db

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage — set STORAGE_PROVIDER=local for dev, s3 for production
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=./uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_S3_BUCKET=pmgis-uploads

# Email — set EMAIL_PROVIDER=console for dev, sendgrid for production
EMAIL_PROVIDER=console
SENDGRID_API_KEY=your_key_here
EMAIL_FROM=noreply@precisionmappinggis.com

# SMS — set SMS_PROVIDER=console for dev, msg91 for production
SMS_PROVIDER=console
MSG91_AUTH_KEY=your_key_here
MSG91_SENDER_ID=PMGIS

# Company
COMPANY_NAME="Precision Mapping GIS"
